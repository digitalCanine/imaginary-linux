# ========================================
# Imaginary Linux – Installer .gitignore
# ========================================

# ----------------------------------------
# Generated / local-only scripts
# ----------------------------------------

# Local version bump helper (not tracked)
installer/version.sh

# Optional: backup files created by sed
*.bak
*~

# ----------------------------------------
# Build / install artifacts
# ----------------------------------------

# Mounted install targets
mnt/
rootfs/

# Logs
*.log
logs/

# Cache directories
.cache/
.cache-installer/
pacman-cache/

# ----------------------------------------
# Editor / OS junk
# ----------------------------------------

# Vim
*.swp
*.swo

# VS Code
.vscode/

# JetBrains
.idea/

# macOS (just in case)
.DS_Store

# ----------------------------------------
# Temporary ISO / image outputs
# ----------------------------------------

*.iso
*.img
*.qcow2
*.raw

# ----------------------------------------
# Secrets (never commit)
# ----------------------------------------

*.key
*.pem
*.env
.env.*

# ----------------------------------------
# Debug dumps
# ----------------------------------------

core

